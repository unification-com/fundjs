    "@protobufs/gogoproto": "^0.0.10",
    "@protobufs/google": "^0.0.10",
    "@protobufs/ibc": "^0.1.0",
    "@protobufs/stargaze": "^0.1.0",
    "@protobufs/tendermint": "^0.0.10"
  },
  "dependencies": {
    "@chain-registry/v2": "^1.71.237",
    "@chain-registry/v2-types": "^0.53.146",
    "@cosmjs/amino": "^0.38.0",
    "@cosmjs/crypto": "^0.38.0",
    "@cosmjs/proto-signing": "^0.38.0",
    "@cosmjs/stargate": "^0.38.0",
    "@cosmjs/tendermint-rpc": "^0.38.0",
    "@cosmology/lcd": "^0.13.4",
    "@interchainjs/cosmos": "^1.20.0",
    "@interchainjs/encoding": "^1.20.0",
    "@interchainjs/math": "^1.20.0",
    "@interchainjs/pubkey": "^1.20.0",
    "@interchainjs/types": "^1.20.0",
    "cosmjs-types": "^0.9.0"
  },
  "keywords": []
